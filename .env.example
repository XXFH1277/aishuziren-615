# Public frontend API base URL. Safe to expose in Vite.
VITE_API_BASE_URL=http://localhost:3000

# Model API keys are backend-only placeholders.
# Never use VITE_ prefixes for model API keys, because Vite exposes them to the browser bundle.
KIMI_API_KEY=your_kimi_api_key_here
MIMO_API_KEY=your_mimo_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Public non-secret model preference placeholder for local prototypes only.
VITE_DEFAULT_TEXT_MODEL=kimi

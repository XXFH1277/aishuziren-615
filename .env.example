# Public frontend API base URL. Safe to expose in Vite.
VITE_API_BASE_URL=http://localhost:3000

# Backend CORS allowlist. Comma-separated origins. Localhost is allowed by default for development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_LOCALHOST=true

# Backend-only AI provider guardrail placeholders. Real provider calls remain disabled by default.
AI_REAL_PROVIDER_ENABLED=false
AI_REAL_PROVIDER_SAFETY_APPROVED=false
AI_PROVIDER_TIMEOUT_MS=15000
AI_PROVIDER_PER_MINUTE_LIMIT=20
AI_PROVIDER_DAILY_CALL_LIMIT=200
AI_PROVIDER_DAILY_BUDGET=120
AI_PROVIDER_MAX_COST_PER_CALL=0

# Master key (KEK) for encrypting customer/platform model API keys at rest (AES-256-GCM).
# 32 bytes as 64 hex chars (e.g. `openssl rand -hex 32`). Backend-only; never commit a real value.
# If empty, the UI will only store a masked status and real calls fall back to the platform env keys below.
CRED_ENC_KEY=

# Platform-level (fallback) model API keys. Used when a tenant has not configured its own encrypted key.
# Backend-only placeholders. Never use VITE_ prefixes for model API keys (Vite exposes them to the browser).
KIMI_API_KEY=your_kimi_api_key_here
MIMO_API_KEY=your_mimo_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DASHSCOPE_API_KEY=your_dashscope_qwen_api_key_here

# Digital human realtime driver. Default = stub (wire the console with NO Tencent account needed).
# Set true and add the real adapter + TENCENT_* credentials once a Tencent Cloud Digital Human channel is purchased.
TENCENT_DH_ENABLED=false
# Optional placeholder preview stream (e.g. a sample video URL) shown while running the stub.
DH_STUB_STREAM_URL=

# Public non-secret model preference placeholder for local prototypes only.
VITE_DEFAULT_TEXT_MODEL=kimi
